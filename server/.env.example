# Executive PA - Server environment (example). Copy to .env and fill real values.
# NEVER commit the real .env file.

NODE_ENV=development
PORT=4000

# MongoDB connection string (local dev below; Atlas: mongodb+srv://user:pass@cluster/db)
# DATABASE_URL=mongodb://executive_pa:CHANGE_ME@localhost:27017/executive_pa?authSource=admin
DATABASE_URL=mongodb+srv://sumo05156_db_user:Sandeep123@cluster0.a6jzqjv.mongodb.net/Tirupati_Inovation_Center?appName=Cluster0/excutive_pa

# Frontend origin (CORS)
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000

# The single approved account allowed to sign in (email + password auth)
ALLOWED_USER_EMAIL=your.work.email@company.com

# Backend session signing secret (min 32 chars in production)
JWT_SECRET=dev-only-session-secret-change-me-32chars-minimum-length

# Seed-only: password for the primary user when running `npm run db:seed`
# (falls back to dev default 'ChangeMe123!' when unset - change it after first login)
PRIMARY_USER_PASSWORD=ChangeMe123!

# ============================================================
# Microsoft Entra ID + Outlook Calendar (Microsoft Graph API)
# ============================================================
# Register a Single-page application (SPA) in Entra admin center:
#   https://entra.microsoft.com/ → App registrations → New registration
#   Supported account types: Accounts in this organizational directory only (Single tenant)
#   Redirect URI (SPA): http://localhost:5173  (and your production URL, HTTPS)
#
# Delegated Microsoft Graph permissions (admin consent NOT needed for these):
#   openid, profile, email, User.Read, Calendars.Read
#
# IMPORTANT: For the shared manager calendar to work:
#   1. Your manager (Dr. Singh) must share their Outlook calendar WITH your Microsoft account
#   2. In Outlook: Share → Calendar permissions → Add your account (at least "Can view all details")
#   3. The app will list all calendars visible to your signed-in Microsoft account;
#      pick the manager's shared calendar from the dropdown on the Calendar page.

# Application (client) ID from Entra App Registration
MICROSOFT_CLIENT_ID=

# Directory (tenant) ID from Entra App Registration
MICROSOFT_TENANT_ID=

# Client Secret (optional for SPA flow; needed only if you add confidential-client flows later)
# For pure SPA + PKCE (this app's current design), leave BLANK — never ship a client secret to the browser.
MICROSOFT_CLIENT_SECRET=

# (Optional) Your manager / shared calendar owner email — used as a default label hint in the UI.
# Example: dr.singh@company.com
MANAGER_EMAIL=

# (Optional) Override the delegated Graph scopes CSV. Default is read-only calendar plus sign-in.
# Do NOT add Mail.Read or mailbox-scoped permissions; the plan forbids email access.
MICROSOFT_GRAPH_SCOPES=Calendars.Read,User.Read,openid,profile,email