# Client environment - ONLY browser-safe values here.
# Never put secrets, passwords or tokens in Vite env.

# API base (blank = same origin via Vite proxy)
VITE_API_BASE_URL=

# ============================================================
# Microsoft Entra ID + Outlook Calendar (MSAL / SPA auth)
# ============================================================
# These values come from Entra admin center (App Registration).
# They are PUBLIC values — it is SAFE to ship them to the browser
# because MSAL.js uses Authorization Code + PKCE (no client secret).
#
# Setup steps:
#  1. Go to https://entra.microsoft.com/
#  2. App registrations → New registration
#     - Name: Executive PA (or your choice)
#     - Supported account types: Accounts in this organizational directory only (Single tenant)
#     - Redirect URI → Select "Single-page application (SPA)" → http://localhost:5173
#       (Add your production HTTPS URL also, e.g. https://your-app.netlify.app)
#  3. Register
#  4. Copy "Application (client) ID" → VITE_MSAL_CLIENT_ID
#  5. Copy "Directory (tenant) ID" → VITE_MSAL_TENANT_ID
#  6. API permissions → Add Microsoft Graph delegated permissions:
#     openid, profile, email, User.Read, Calendars.Read
#     (Grant admin consent if your tenant requires it; usually not needed for these scopes)

# Application (client) ID
VITE_MSAL_CLIENT_ID=

# Directory (tenant) ID
VITE_MSAL_TENANT_ID=

# Authority URL (constructed from tenant ID — leave as default)
VITE_MSAL_AUTHORITY=https://login.microsoftonline.com/VITE_MSAL_TENANT_ID

# Redirect URI — must match exactly what you registered in Entra
VITE_MSAL_REDIRECT_URI=

# Post-logout redirect (optional — defaults to /)
VITE_MSAL_POST_LOGOUT_REDIRECT_URI=

# (Optional) Manager / shared calendar owner email — label hint only
VITE_MANAGER_EMAIL=

# Graph scopes CSV (delegated / read-only) — do not add Mail.Read
VITE_MSAL_GRAPH_SCOPES=Calendars.Read,User.Read,openid,profile,email
